{
  "components": {
    "schemas": {
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "location",
          "message"
        ],
        "type": "object"
      },
      "IdentityAccount": {
        "additionalProperties": false,
        "properties": {
          "admin": {
            "type": "boolean"
          },
          "displayName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "admin"
        ],
        "type": "object"
      },
      "IdentityClaimBody": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "pin": {
            "pattern": "^[0-9]{4}$",
            "type": "string"
          }
        },
        "required": [
          "email",
          "displayName",
          "pin"
        ],
        "type": "object"
      },
      "IdentityClaimed": {
        "additionalProperties": false,
        "properties": {
          "account": {
            "$ref": "#/components/schemas/IdentityAccount"
          },
          "apiKey": {
            "pattern": "^ssk_[A-Za-z0-9_-]{43}$",
            "type": "string"
          }
        },
        "required": [
          "account",
          "apiKey"
        ],
        "type": "object"
      },
      "IdentitySession": {
        "additionalProperties": false,
        "properties": {
          "account": {
            "$ref": "#/components/schemas/IdentityAccount"
          }
        },
        "required": [
          "account"
        ],
        "type": "object"
      },
      "IdentitySessionsChanged": {
        "additionalProperties": false,
        "properties": {
          "account": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "account"
        ],
        "type": "object"
      },
      "IdentitySignInBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "pin": {
            "pattern": "^[0-9]{4}$",
            "type": "string"
          }
        },
        "required": [
          "email",
          "pin"
        ],
        "type": "object"
      },
      "LiveResync": {
        "additionalProperties": false,
        "type": "object"
      },
      "LiveSessionEnded": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "enum": [
              "signed-out",
              "expired"
            ],
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "status": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "code",
          "title"
        ],
        "type": "object"
      },
      "SystemBuild": {
        "additionalProperties": false,
        "properties": {
          "commit": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "libtorrent": {
            "type": "string"
          },
          "nativeBundle": {
            "type": "string"
          },
          "stamped": {
            "type": "boolean"
          },
          "target": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "stamped"
        ],
        "type": "object"
      },
      "SystemHealth": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "SystemListeners": {
        "additionalProperties": false,
        "properties": {
          "control": {
            "type": "string"
          },
          "http": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "torrent": {
            "type": "string"
          }
        },
        "required": [
          "http",
          "torrent",
          "link",
          "control"
        ],
        "type": "object"
      },
      "SystemReport": {
        "additionalProperties": false,
        "properties": {
          "build": {
            "$ref": "#/components/schemas/SystemBuild"
          },
          "dataDir": {
            "type": "string"
          },
          "listeners": {
            "$ref": "#/components/schemas/SystemListeners"
          },
          "pid": {
            "format": "int64",
            "type": "integer"
          },
          "seed": {
            "type": "string"
          },
          "startedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "build",
          "dataDir",
          "pid",
          "seed",
          "startedAt",
          "listeners"
        ],
        "type": "object"
      },
      "SystemStatus": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "enum": [
              "unclaimed",
              "controller",
              "worker"
            ],
            "type": "string"
          }
        },
        "required": [
          "claim"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKey": {
        "in": "header",
        "name": "X-Api-Key",
        "type": "apiKey"
      },
      "session": {
        "in": "cookie",
        "name": "slipstream_session",
        "type": "apiKey"
      },
      "setupCode": {
        "in": "header",
        "name": "X-Setup-Code",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "SlipStream",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/events": {
      "get": {
        "operationId": "streamEvents",
        "parameters": [
          {
            "description": "The id of the last event a dropped stream received",
            "in": "header",
            "name": "Last-Event-ID",
            "schema": {
              "description": "The id of the last event a dropped stream received",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "description": "Each oneOf object in the array represents one possible Server Sent Events (SSE) message, serialized as UTF-8 text according to the SSE specification.",
                  "items": {
                    "oneOf": [
                      {
                        "properties": {
                          "data": {
                            "$ref": "#/components/schemas/IdentitySessionsChanged"
                          },
                          "event": {
                            "const": "identity.sessions-changed",
                            "description": "The event name.",
                            "type": "string"
                          },
                          "id": {
                            "description": "The event ID.",
                            "type": "integer"
                          },
                          "retry": {
                            "description": "The retry time in milliseconds.",
                            "type": "integer"
                          }
                        },
                        "required": [
                          "data",
                          "event"
                        ],
                        "title": "Event identity.sessions-changed",
                        "type": "object"
                      },
                      {
                        "properties": {
                          "data": {
                            "$ref": "#/components/schemas/LiveResync"
                          },
                          "event": {
                            "const": "live.resync",
                            "description": "The event name.",
                            "type": "string"
                          },
                          "id": {
                            "description": "The event ID.",
                            "type": "integer"
                          },
                          "retry": {
                            "description": "The retry time in milliseconds.",
                            "type": "integer"
                          }
                        },
                        "required": [
                          "data",
                          "event"
                        ],
                        "title": "Event live.resync",
                        "type": "object"
                      },
                      {
                        "properties": {
                          "data": {
                            "$ref": "#/components/schemas/LiveSessionEnded"
                          },
                          "event": {
                            "const": "live.session-ended",
                            "description": "The event name.",
                            "type": "string"
                          },
                          "id": {
                            "description": "The event ID.",
                            "type": "integer"
                          },
                          "retry": {
                            "description": "The retry time in milliseconds.",
                            "type": "integer"
                          }
                        },
                        "required": [
                          "data",
                          "event"
                        ],
                        "title": "Event live.session-ended",
                        "type": "object"
                      }
                    ]
                  },
                  "title": "Server Sent Events",
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "api_key_wrong",
                            "signed_out"
                          ],
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "needs_account"
                          ],
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "worker_node"
                          ],
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "invalid"
                          ],
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "internal"
                          ],
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Stream the events this session may see",
        "tags": [
          "live"
        ],
        "x-slipstream-access": "account"
      }
    },
