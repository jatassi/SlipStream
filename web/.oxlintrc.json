        "no-restricted-properties": [
          "error",
          {
            "property": "waitForTimeout",
            "message": "wait on a condition with expect(); skip only with skipFlaky(issue)"
          },
          {
            "object": "test",
            "property": "only",
            "message": "wait on a condition with expect(); skip only with skipFlaky(issue)"
          },
          {
            "object": "test",
