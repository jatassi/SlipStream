{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "description": {
      "type": "string"
    },
    "seed": {
      "type": "string"
    },
    "admin": {
      "properties": {
        "email": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "pin": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "email",
        "display_name",
        "pin"
      ]
    },
    "nodes": {
      "items": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,15}$"
          },
          "setup": {
            "type": "string",
            "enum": [
              "none",
              "controller"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ]
      },
      "type": "array",
      "maxItems": 31,
      "minItems": 1
    },
    "timings": {
      "properties": {
        "node": {
          "properties": {
            "stop_deadline": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "storage": {
          "properties": {
            "busy_timeout": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "http": {
          "properties": {
            "read_header": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "idle": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "live": {
          "properties": {
            "heartbeat": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "retry": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "link": {
          "properties": {
            "handshake": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "keepalive": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "write_timeout": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "redial_min": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "redial_max": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "fallback_delay": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "role": {
          "properties": {
            "restart_min": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "restart_max": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "nodes"
  ]
}
