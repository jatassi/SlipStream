{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "description": {
      "type": "string"
    },
    "seed": {
      "type": "string"
    },
    "admin": {
      "properties": {
        "email": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "pin": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "email",
        "display_name",
        "pin"
      ]
    },
    "nodes": {
      "items": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,15}$"
          },
          "setup": {
            "type": "string",
            "enum": [
              "none",
              "controller",
              "join"
            ]
          },
          "roles": {
            "items": {
              "type": "string",
              "enum": [
                "searching",
                "downloading",
                "storage",
                "converting",
                "subtitles",
                "metadata",
                "media-server-link",
                "notifying",
                "relaying",
                "serving"
              ]
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ]
      },
      "type": "array",
      "maxItems": 31,
      "minItems": 1
    },
    "timings": {
      "properties": {
        "node": {
          "properties": {
            "stop_deadline": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "storage": {
          "properties": {
            "busy_timeout": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "http": {
          "properties": {
            "read_header": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "idle": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "live": {
          "properties": {
            "heartbeat": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "retry": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "link": {
          "properties": {
            "handshake": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "keepalive": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "write_timeout": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "redial_min": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "redial_max": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "fallback_delay": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "role": {
          "properties": {
            "restart_min": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "restart_max": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "works": {
          "properties": {
            "fetch": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "indexers": {
          "properties": {
            "request": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "transfers": {
          "properties": {
            "chunk": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "grabs": {
          "properties": {
            "retry_min": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "retry_max": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "progress": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "downloading": {
          "properties": {
            "facts": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "media": {
          "properties": {
            "probe": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "music": {
      "properties": {
        "artists": {
          "items": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "revisions": {
                "items": {
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "sort_name": {
                      "type": "string"
                    },
                    "country": {
                      "type": "string"
                    },
                    "disambiguation": {
                      "type": "string"
                    },
                    "albums": {
                      "items": {
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "release": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "title": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "Album",
                              "EP",
                              "Single"
                            ]
                          },
                          "first_release": {
                            "type": "string",
                            "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
                          },
                          "tracks": {
                            "items": {
                              "properties": {
                                "recording": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                "title": {
                                  "type": "string"
                                },
                                "length": {
                                  "type": "string",
                                  "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
                                },
                                "disc": {
                                  "type": "integer",
                                  "minimum": 1
                                }
                              },
                              "additionalProperties": false,
                              "type": "object",
                              "required": [
                                "recording",
                                "title",
                                "disc"
                              ]
                            },
                            "type": "array"
                          }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "id",
                          "release",
                          "title",
                          "kind"
                        ]
                      },
                      "type": "array"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "name",
                    "sort_name"
                  ]
                },
                "type": "array",
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "revisions"
            ]
          },
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "artists"
      ]
    },
    "tmdb": {
      "properties": {
        "movies": {
          "items": {
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "imdb_id": {
                "type": "string",
                "pattern": "^tt[0-9]{7,}$"
              },
              "title": {
                "type": "string"
              },
              "released": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "runtime": {
                "type": "string",
                "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "imdb_id",
              "title",
              "released",
              "runtime"
            ]
          },
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "movies"
      ]
    },
    "releases": {
      "items": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "tmdb_id": {
            "type": "integer",
            "minimum": 1
          },
          "video": {
            "properties": {
              "width": {
                "type": "integer",
                "multipleOf": 2,
                "maximum": 7680,
                "minimum": 2
              },
              "height": {
                "type": "integer",
                "multipleOf": 2,
                "maximum": 4320,
                "minimum": 2
              },
              "seconds": {
                "type": "integer",
                "maximum": 60,
                "minimum": 1
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "width",
              "height",
              "seconds"
            ]
          },
          "seeders": {
            "type": "integer",
            "minimum": 0
          },
          "seeded": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "tmdb_id",
          "video"
        ]
      },
      "type": "array"
    },
    "tracker": {
      "properties": {
        "interval": {
          "type": "string",
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "library": {
      "properties": {
        "roots": {
          "items": {
            "properties": {
              "content_type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]{1,15}$"
              },
              "folder": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "content_type",
              "folder"
            ]
          },
          "type": "array"
        },
        "targets": {
          "items": {
            "properties": {
              "name": {
                "type": "string"
              },
              "resolutions": {
                "items": {
                  "type": "string",
                  "enum": [
                    "2160p",
                    "1080p",
                    "720p",
                    "576p",
                    "480p"
                  ]
                },
                "type": "array",
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "resolutions"
            ]
          },
          "type": "array"
        },
        "profiles": {
          "items": {
            "properties": {
              "name": {
                "type": "string"
              },
              "content_type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]{1,15}$"
              },
              "targets": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "content_type",
              "targets"
            ]
          },
          "type": "array"
        },
        "indexers": {
          "items": {
            "properties": {
              "name": {
                "type": "string"
              },
              "site": {
                "type": "string",
                "enum": [
                  "fixture-site"
                ]
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "site"
            ]
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "faults": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "fault": {
            "type": "string"
          },
          "skip": {
            "type": "integer",
            "minimum": 0
          },
          "times": {
            "type": "integer",
            "minimum": 0
          },
          "after": {
            "properties": {
              "kind": {
                "type": "string"
              },
              "node": {
                "type": "string"
              },
              "match": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "after": {
                "type": "integer"
              }
            },
            "additionalProperties": false,
            "type": "object"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "target",
          "fault"
        ]
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "nodes"
  ]
}
