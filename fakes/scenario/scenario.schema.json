{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "description": {
      "type": "string"
    },
    "seed": {
      "type": "string"
    },
    "admin": {
      "properties": {
        "email": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "pin": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "email",
        "display_name",
        "pin"
      ]
    },
    "nodes": {
      "items": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,15}$"
          },
          "setup": {
            "type": "string",
            "enum": [
              "none",
              "controller",
              "join"
            ]
          },
          "roles": {
            "items": {
              "type": "string",
              "enum": [
                "searching",
                "downloading",
                "storage",
                "converting",
                "subtitles",
                "metadata",
                "media-server-link",
                "notifying",
                "relaying",
                "serving"
              ]
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ]
      },
      "type": "array",
      "maxItems": 31,
      "minItems": 1
    },
    "timings": {
      "properties": {
        "node": {
          "properties": {
            "stop_deadline": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "storage": {
          "properties": {
            "busy_timeout": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "http": {
          "properties": {
            "read_header": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "idle": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "live": {
          "properties": {
            "heartbeat": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "retry": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "link": {
          "properties": {
            "handshake": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "keepalive": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "write_timeout": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "redial_min": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "redial_max": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "fallback_delay": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "role": {
          "properties": {
            "restart_min": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            },
            "restart_max": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "works": {
          "properties": {
            "fetch": {
              "type": "string",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "music": {
      "properties": {
        "artists": {
          "items": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "revisions": {
                "items": {
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "sort_name": {
                      "type": "string"
                    },
                    "country": {
                      "type": "string"
                    },
                    "disambiguation": {
                      "type": "string"
                    },
                    "albums": {
                      "items": {
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "release": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "title": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "Album",
                              "EP",
                              "Single"
                            ]
                          },
                          "first_release": {
                            "type": "string",
                            "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
                          },
                          "tracks": {
                            "items": {
                              "properties": {
                                "recording": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                "title": {
                                  "type": "string"
                                },
                                "length": {
                                  "type": "string",
                                  "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
                                },
                                "disc": {
                                  "type": "integer",
                                  "minimum": 1
                                }
                              },
                              "additionalProperties": false,
                              "type": "object",
                              "required": [
                                "recording",
                                "title",
                                "disc"
                              ]
                            },
                            "type": "array"
                          }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "id",
                          "release",
                          "title",
                          "kind"
                        ]
                      },
                      "type": "array"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "name",
                    "sort_name"
                  ]
                },
                "type": "array",
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "revisions"
            ]
          },
          "type": "array",
          "minItems": 1
        },
        "faults": {
          "items": {
            "properties": {
              "artist": {
                "type": "string"
              },
              "answer": {
                "type": "string",
                "enum": [
                  "not_found",
                  "unavailable",
                  "slow"
                ]
              },
              "times": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "artist",
              "answer",
              "times"
            ]
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "artists"
      ]
    },
    "tmdb": {
      "properties": {
        "movies": {
          "items": {
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "imdb_id": {
                "type": "string",
                "pattern": "^tt[0-9]{7,}$"
              },
              "title": {
                "type": "string"
              },
              "released": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "runtime": {
                "type": "string",
                "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "imdb_id",
              "title",
              "released",
              "runtime"
            ]
          },
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "movies"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "nodes"
  ]
}
