#!/bin/sh
set -eu
if [ "$(id -u)" != 0 ]; then
	exec /usr/local/lib/slipstream/slipstream "$@"
fi
groupmod -o -g "${PGID:-1000}" slipstream
usermod -o -u "${PUID:-1000}" slipstream
for dev in /dev/dri/renderD*; do
	[ -e "$dev" ] || continue
	gid=$(stat -c %g "$dev")
	group=$(getent group "$gid" | cut -d : -f 1)
	if [ -z "$group" ]; then
		group=render$gid
		groupadd -g "$gid" "$group"
	fi
	usermod -a -G "$group" slipstream
done
if [ "$(stat -c %u /config)" = 0 ] && [ -z "$(ls -A /config)" ]; then
	chown slipstream:slipstream /config
fi
exec setpriv --reuid=slipstream --regid=slipstream --init-groups /usr/local/lib/slipstream/slipstream "$@"
