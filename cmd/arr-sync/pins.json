        "/src/NzbDrone.Core/Qualities/QualitySource.cs",
        "/src/NzbDrone.Core/Qualities/Modifier.cs",
        "/src/NzbDrone.Core/Languages/Language.cs",
        "/src/NzbDrone.Core/CustomFormats/",
        "/src/NzbDrone.Core.Test/ParserTests/"
