POST /message
Content-Type: application/json
X-Gotify-Key: [set]

{
  "title": "Den's disk is almost full",
  "message": "Movies has 4 GB free of 2 TB.\nIt has been on Health since 13:57.",
  "priority": 8,
  "extras": {
    "client::display": {
      "contentType": "text/plain"
    },
    "client::notification": {
      "click": {
        "url": "https://slipstream.example/health#health-storage-den"
      }
    }
  }
}
